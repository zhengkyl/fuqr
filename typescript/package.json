{
  "name": "furious-qr",
  "version": "2.3.0",
  "description": "A small and hackable QR code generator",
  "license": "MIT",
  "author": "Kyle Zheng <kylezheng73@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhengkyl/furious-qr.git",
    "directory": "typescript"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "main": "dist/furious-qr.js",
  "types": "dist/furious-qr.d.ts",
  "exports": {
    ".": {
      "types": "./dist/furious-qr.d.ts",
      "default": "./dist/furious-qr.js"
    },
    "./extras/*": {
      "types": "./dist/extras/*.d.ts",
      "default": "./dist/extras/*.js"
    }
  },
  "scripts": {
    "build": "tsc"
  }
}
