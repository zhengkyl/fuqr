{
  "name": "fuqr",
  "version": "2.1.0",
  "description": "A small and hackable QR code generator",
  "license": "MIT",
  "author": "Kyle Zheng <kylezheng73@gmail.com>",
  "files": [
    "dist/"
  ],
  "type": "module",
  "main": "dist/fuqr.js",
  "types": "dist/fuqr.d.ts",
  "exports": {
    ".": {
      "types": "./dist/fuqr.d.ts",
      "default": "./dist/fuqr.js"
    },
    "./extras/*": {
      "types": "./dist/extras/*.d.ts",
      "default": "./dist/extras/*.js"
    }
  },
  "scripts": {
    "build": "tsc"
  }
}
