{
  // Based on https://www.totaltypescript.com/tsconfig-cheat-sheet
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "module": "NodeNext",
    "rootDir": "..",
    "outDir": "./dist",
    "declaration": true,
    "lib": [
      "es2022",
      "dom"
    ]
  }
}