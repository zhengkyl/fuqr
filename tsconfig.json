{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "lib": [
      "es2022",
      "dom"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "typescript/**/*.ts",
  ]
}